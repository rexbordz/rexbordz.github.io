{
  "sections": [
    {
      "title": "Core Configuration",
      "fields": [
        {
          "id": "font",
          "label": "Font",
          "type": "font",
          "defaultValue": "",
          "placeholder": "Google Sans",
          "bundledFonts": [
            {
              "name": "Google Sans",
              "css": "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap"
            },
            {
              "name": "Roboto",
              "css": "https://fonts.googleapis.com/css2?family=Roboto&display=swap"
            }
          ]
        },
        {
          "id": "size",
          "label": "Font Size (px)",
          "type": "number",
          "defaultValue": "",
          "placeholder": 26
        },
        {
          "id": "duration",
          "label": "Alert Duration (seconds)",
          "type": "number",
          "defaultValue": "",
          "placeholder": 3
        },
        {
          "id": "alignRight",
          "label": "Alert Alignment",
          "type": "select",
          "defaultValue": "true",
          "options": [
            { "label": "Align Right", "value": "true" },
            { "label": "Align Left", "value": "false" }
          ]
        },
        {
          "id": "appearance",
          "label": "Appearance",
          "type": "select",
          "defaultValue": "light",
          "options": [
            { "label": "Light", "value": "light" },
            { "label": "Dark", "value": "dark" }
          ]
        },
        {
          "id": "soundEnabled",
          "label": "Enable Alert Sound",
          "type": "checkbox",
          "defaultValue": true
